# Shared configure/build-time encoder for exact Fortran character strings.
function(nci_build_string name value)
  string(HEX "${value}" _hex)
  string(LENGTH "${_hex}" _length)
  set(_body "function ${name}() result(value)\ncharacter(:), allocatable :: value\nvalue = ''\n")
  set(_line "value = value")
  set(_count 0)
  while(_length GREATER 0)
    string(SUBSTRING "${_hex}" 0 2 _byte)
    math(EXPR _decimal "0x${_byte}")
    string(APPEND _line " // achar(${_decimal})")
    math(EXPR _count "${_count}+1")
    string(SUBSTRING "${_hex}" 2 -1 _hex)
    math(EXPR _length "${_length}-2")
    if(_count EQUAL 6 OR _length EQUAL 0)
      string(APPEND _body "${_line}\n")
      set(_line "value = value")
      set(_count 0)
    endif()
  endwhile()
  string(APPEND _body "end function ${name}\n")
  set(_nci_metadata "${_nci_metadata}${_body}" PARENT_SCOPE)
endfunction()
